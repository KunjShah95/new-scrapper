# R2 credentials for cloudflare/r2_sync.py
#
# Create at: Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API token
#   Permissions: Object Read & Write
#   Scope:       only the bucket named below
#
# Copy this file to cloudflare/.env (already git-ignored) and fill in the values.

# S3 endpoint shown on the bucket's settings page. Takes precedence over
# R2_ACCOUNT_ID; either one works.
R2_ENDPOINT=
# R2_ACCOUNT_ID=

# From the API token screen (the secret is shown once, at creation).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=lrms-legal-pdfs

# Destination routing. Binary documents (PDF/images/zip) go under the PDF
# prefix, everything textual (JSON/Markdown/CSV/GeoJSON) under the JSON prefix.
# The `gujrera` segment keeps this scraper separate from other data in the bucket.
R2_PDF_PREFIX=main_pdfs/ircms/gujrera
R2_JSON_PREFIX=scraper/json/gujrera
