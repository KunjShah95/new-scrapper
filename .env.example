# Egress proxy (optional). Copy to .env and fill in; .env is gitignored.
#
# Either the whole URL...
GUJRERA_PROXY=

# ...or the parts. If GUJRERA_PROXY is set, the parts below are ignored.
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
PROXY_SCHEME=http
# Provider-side targeting, appended to the username. DataImpulse: __cr.in (India)
PROXY_USER_SUFFIX=

# Set to 0 to fail instead of falling back to a direct connection when the proxy
# cannot tunnel to the portal.
GUJRERA_PROXY_FALLBACK=1
