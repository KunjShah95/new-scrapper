# GujRERA scraper — environment
#
# Copy to .env and `chmod 600 .env`. The systemd units read this file; run.py
# also reads it locally, and a real environment variable always wins.

# ---- Cloudflare R2 -------------------------------------------------------------
# R2 → API → Manage API Tokens → Create API token with "Object Read & Write".
# Either the account id or the full endpoint URL.
R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lrms-legal-pdfs

# REQUIRED, and must match the machine that wrote the existing data. Every key
# in the state db is logical (blobs/..., projects/...); these prefixes place it
# in the bucket. Leave them empty and the VPS writes to the bucket root, the
# restored state points at objects it cannot find, and documents re-download.
R2_PDF_PREFIX=main_pdfs/ircms/gujrera
R2_JSON_PREFIX=scraper/json/gujrera

# Public base URL for blobs. Attach a custom domain to the bucket first —
# r2.dev is rate-limited and not meant for production traffic.
#   R2_PUBLIC_BASE=https://files.example.com
R2_PUBLIC_BASE=

# ---- Egress proxy (optional) ---------------------------------------------------
# A VPS in a datacentre may be refused by the portal. If `--proxy-test` shows
# the direct connection failing, use a residential proxy.
#
# Either the whole URL:
#   GUJRERA_PROXY=http://user:pass@gw.example.com:823
#
# …or the parts, which is friendlier for rotating accounts:
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=
# PROXY_SCHEME=http            # http | socks5 | socks5h
# PROXY_USER_SUFFIX=__cr.in    # provider-side geo targeting, appended to the user
#
# Set to 0 to fail fast instead of retrying direct when the proxy refuses.
# GUJRERA_PROXY_FALLBACK=1

# ---- Scrape behaviour ----------------------------------------------------------
# Politeness delay between requests, in seconds. Do not go below 0.25.
GUJRERA_DELAY=

# Concurrency. Defaults are tuned for a small VPS; raise them only if the
# portal is comfortably keeping up.
GUJRERA_PROJECT_WORKERS=
GUJRERA_ENDPOINT_WORKERS=
GUJRERA_DOC_WORKERS=
# Hard cap on document downloads in flight across all projects (default 16).
GUJRERA_MAX_CONCURRENT_DOCS=
